# Express HTTP server port (default: 5000)
PORT=5000

# Runtime environment: development, test, or production (default: development)
NODE_ENV=development

# Allowed frontend origin for CORS (default: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# Local standalone MongoDB connection string (matches ARCHITECTURE.md section 14.1)
MONGODB_URI=mongodb://127.0.0.1:27017/fairticket

# REQUIRED SECRET (minimum 32 characters) - NEVER commit real values.
# Generate a strong secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_generated_secret_of_at_least_32_characters

# Auth JWT expiration window (default: 12h per ARCHITECTURE.md section 14.1)
JWT_EXPIRES_IN=12h

# Expected JWT issuer claim (default: fairticket)
JWT_ISSUER=fairticket

# Expected JWT audience claim (default: fairticket-web)
JWT_AUDIENCE=fairticket-web

# Maximum consecutive failed logins before temporary account lockout (default: 5)
AUTH_MAX_FAILED_LOGINS=5

# Temporary account lockout duration in minutes (default: 15)
AUTH_LOCK_MINUTES=15

# Maximum login attempts per 15 minutes per IP + normalized email (default: 10)
AUTH_LOGIN_RATE_LIMIT_MAX=10

# Maximum registration attempts per 60 minutes per IP (default: 5)
AUTH_REGISTER_RATE_LIMIT_MAX=5

# Optional password for demo staff seed script (npm run seed:staff, non-production only).
# Must meet password policy (>= 10 chars, letter + number). Leave unset to generate once.
# SEED_STAFF_PASSWORD=

# REQUIRED SECRET (minimum 32 characters, MUST be different from JWT_SECRET).
# Generate a strong secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# WARNING: Never change this after users have verified their identity. Changing it breaks duplicate-identity detection. Back it up securely. Never commit it.
IDENTITY_HASH_SECRET=replace_this_with_a_different_generated_secret_of_at_least_32_characters

# Identity verification provider adapter (default: mock; only "mock" is allowed in demo)
IDENTITY_PROVIDER=mock

# Maximum simulated identity verification submissions allowed per user in a rolling 24-hour window (default: 5)
IDENTITY_MAX_ATTEMPTS_PER_DAY=5

# Maximum identity verification submit requests per 60 minutes per IP+user (default: 10)
IDENTITY_SUBMIT_RATE_LIMIT_MAX=10

# Duplicate-identity attempts by one user within 24 hours that trigger a CRITICAL repeated-duplicate alert (default: 3, range: 1-20)
IDENTITY_DUPLICATE_FLAG_THRESHOLD=3

# Legacy placeholder kept for reference (superseded by IDENTITY_HASH_SECRET)
IDENTITY_HASH_SALT=change_me_unique_identity_salt_secret

# Number of numeric digits in each simulated phone OTP (default: 6)
OTP_LENGTH=6

# Lifetime of each phone OTP in seconds (default: 300 = 5 minutes)
OTP_TTL_SECONDS=300

# Maximum wrong guesses allowed per OTP before requiring a new code (default: 5)
OTP_MAX_ATTEMPTS=5

# Minimum seconds a user must wait before requesting another OTP (default: 30)
OTP_RESEND_COOLDOWN_SECONDS=30

# Maximum OTP sends allowed per user within a rolling 60-minute window (default: 5)
OTP_MAX_SENDS_PER_HOUR=5

# Maximum OTP send requests per 60 minutes per IP+user (default: 10)
OTP_SEND_RATE_LIMIT_MAX=10

# Maximum OTP verify requests per 15 minutes per IP+user (default: 30)
OTP_VERIFY_RATE_LIMIT_MAX=30

# Simulated SMS provider adapter: "console" (prints to dev terminal) or "mock" (in-memory for tests)
SMS_PROVIDER=console

# Show demoOtp in the send-OTP API response so local demos work without reading terminal logs.
# Defaults to false in code and is ALWAYS forced to false when NODE_ENV=production.
DEMO_SHOW_OTP=true

# Legacy placeholder kept for reference (OTP HMAC key is derived from JWT_SECRET with label "fairticket:otp:v1")
OTP_HASH_SALT=change_me_unique_otp_salt_secret

# Secret HMAC-SHA256 key for signing 30-second entry QR tokens (Prompt 23+) - NEVER commit real values
QR_SIGNING_SECRET=change_me_unique_qr_hmac_secret

# Expected EVM chain ID bound into wallet-linking signature challenges (default: 31337 = local Hardhat)
WALLET_CHAIN_ID=31337

# Lifetime in seconds for each single-use wallet challenge message (default: 300 = 5 minutes)
WALLET_CHALLENGE_TTL_SECONDS=300

# Maximum failed signature verification attempts allowed per challenge before locking (default: 5)
WALLET_MAX_VERIFY_ATTEMPTS=5

# Maximum wallet linking challenges issued per user within a rolling 60-minute window (default: 10)
WALLET_CHALLENGE_MAX_PER_HOUR=10

# Maximum wallet challenge requests per 60 minutes per IP+user (default: 20)
WALLET_CHALLENGE_RATE_LIMIT_MAX=20

# Maximum wallet signature verify requests per 15 minutes per IP+user (default: 30)
WALLET_VERIFY_RATE_LIMIT_MAX=30

# Maximum event write requests (create, edit, publish, cancel) per 60 minutes per user (default: 60)
EVENT_WRITE_RATE_LIMIT_MAX=60

# Maximum public event listing read requests per 15 minutes per IP (default: 200)
EVENT_READ_RATE_LIMIT_MAX=200

# Local Hardhat JSON-RPC URL (default: http://127.0.0.1:8545)
HARDHAT_RPC_URL=http://127.0.0.1:8545

# Local Hardhat chain ID (default: 31337)
CHAIN_ID=31337

# Deployed FairTicket.sol contract address on local Hardhat (set after Prompt 15 deploy)
FAIRTICKET_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Hardhat local Account #1 private key for VERIFIER_ROLE (demo only - NEVER commit real keys)
VERIFIER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Hardhat local Account #2 private key for ORGANIZER_ROLE (demo only - NEVER commit real keys)
ORGANIZER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Hardhat local Account #3 private key for GATE_ROLE (demo only - NEVER commit real keys)
GATE_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# Trust Guardian plain-English explainer mode (default: DETERMINISTIC_TEMPLATE)
TRUST_GUARDIAN_EXPLAINER_MODE=DETERMINISTIC_TEMPLATE

# Global API rate limiter window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Global API rate limiter maximum requests per IP per window (default: 300)
RATE_LIMIT_MAX_REQUESTS=300
