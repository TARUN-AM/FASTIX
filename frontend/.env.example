# Backend REST API base URL (must match backend /api/v1 prefix)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Expected local Hardhat network chain ID
VITE_CHAIN_ID=31337

# Display name for local Hardhat network in MetaMask prompts
VITE_CHAIN_NAME=Hardhat Localhost

# Deployed FairTicket.sol contract address on local Hardhat (set after Prompt 15 deploy)
VITE_FAIRTICKET_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
